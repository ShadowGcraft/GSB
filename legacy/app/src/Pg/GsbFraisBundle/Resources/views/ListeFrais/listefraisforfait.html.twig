<h3>Fiche de frais du mois {{ nummois }}/{{ numannee }}</h3>
<div class="encadre">
  <p class="encadre__etat">
    <span>État : <strong>{{ libetat }}</strong> depuis le {{ datemodif }}</span>
    <span>Montant validé : <strong>{{ montantvalide }} €</strong></span>
  </p>
  <div class="tableau-defilant">
    <table class="listeLegere">
      <caption>Éléments forfaitisés</caption>
      <tr>
        {% for unfrais in lesfraisforfait %}<th>{{ unfrais.libelle }}</th>{% endfor %}
      </tr>
      <tr>
        {% for unfrais in lesfraisforfait %}<td class="qteForfait">{{ unfrais.quantite }}</td>{% endfor %}
      </tr>
    </table>
  </div>
</div>
