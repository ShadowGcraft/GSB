{% extends "PgGsbFraisBundle::layout.html.twig" %}
{% block menu %}
{% set route = app.request.attributes.get('_route') %}
<nav id="menuGauche" aria-label="Navigation principale">
  <div id="infosUtil">
    {% if app.session.get('nom') %}
      <span class="infosUtil__role">Visiteur</span>
      <span class="infosUtil__nom">Bonjour {{ app.session.get('prenom') }} {{ app.session.get('nom') }}</span>
    {% endif %}
  </div>
  <ul id="menuList">
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_home') }}"{% if route == 'pg_gsb_frais_home' %} aria-current="page"{% endif %}>Accueil</a>
    </li>
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_saisirfrais') }}"{% if route == 'pg_gsb_frais_saisirfrais' %} aria-current="page"{% endif %}>Saisir mes frais</a>
    </li>
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_listefrais') }}"{% if route == 'pg_gsb_frais_listefrais' %} aria-current="page"{% endif %}>Mes fiches de frais</a>
    </li>
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_vehicule') }}"{% if route == 'pg_gsb_frais_vehicule' %} aria-current="page"{% endif %}>Mon véhicule</a>
    </li>
  </ul>
  {# Déconnexion isolée en bas du menu, en rouge (cahier-charge-simple). #}
  <a id="deconnexion" href="{{ path('pg_gsb_frais_deconnexion') }}">Déconnexion</a>
</nav>
{% endblock %}
