<div id="contenu">
  <h2 class="titre-section">Dépenses hors forfait</h2>
  {% include 'PgGsbFraisBundle:SaisirFrais:_messages.html.twig' with {'leserreurs': leserreurshorsforfait, 'lessucces': lessucceshorsforfait} %}
  {% include 'PgGsbFraisBundle:ListeFrais:_depenses.html.twig' with {'lesfraishorsforfait': lesfraishorsforfait, 'modifiable': true} only %}

  <form action="{{ path('pg_gsb_frais_validerfraishorsforfais') }}" method="post" enctype="multipart/form-data" id="nouveauHorsForfait">
    <div class="corpsForm">
      <fieldset>
        <legend>Nouvelle dépense</legend>
        <p class="aide-texte">Au prix payé, avec la facture. Repas de midi, nuitée, relais étape et kilomètres se
          déclarent plus haut, en forfait. Les péages ne sont pas remboursés : votre badge télépéage les couvre.</p>

        {# Étape 1 : la catégorie, choisie dans une grille rangée par thème. #}
        <div class="categories" role="radiogroup" aria-labelledby="titreCategories">
          <div class="categories__entete">
            <span class="categories__titre" id="titreCategories"><span class="etape__num" aria-hidden="true">1</span> Catégorie</span>
            {# Affiché par saisie.js : sans JavaScript, la grille reste complète. #}
            <input type="search" id="filtreCategories" class="categories__filtre" placeholder="Rechercher : uber, métro, salle…"
                   aria-label="Rechercher une catégorie" autocomplete="off" hidden />
          </div>
          {% for categorie in lescategories %}
            {% if loop.first or lescategories[loop.index0 - 1].groupe != categorie.groupe %}
              {% if not loop.first %}</div></div>{% endif %}
              <div class="categories__bloc">
                <p class="categories__groupe">{{ categorie.groupe }}</p>
                <div class="categories__grille">
            {% endif %}
            <label class="categorie" data-recherche="{{ (categorie.libelle ~ ' ' ~ categorie.groupe ~ ' ' ~ categorie.motscles)|lower }}">
              <input type="radio" name="idCategorie" value="{{ categorie.id }}" required
                     data-exemple="{{ categorie.exemple }}" />
              <svg class="icone" aria-hidden="true"><use href="#ic-{{ categorie.id }}"/></svg>
              <span>{{ categorie.libelle }}</span>
            </label>
            {% if loop.last %}</div></div>{% endif %}
          {% endfor %}
          <p class="categories__vide" id="categoriesVide" hidden>Aucune catégorie ne correspond. L'hôtel, le repas de midi
            et les kilomètres sont des forfaits, à déclarer plus haut. Sinon, choisissez « Autre », dans Divers.</p>
        </div>

        {# Étape 2 : le détail de la dépense. #}
        <div class="depense-champs">
          <p>
            <label for="txtDateHF"><span class="etape__num" aria-hidden="true">2</span> Date</label>
            <input type="date" id="txtDateHF" name="dateFrais" required min="{{ ilyaunan }}" max="{{ aujourdhui }}" value="" />
          </p>
          <p>
            <label for="txtMontantHF">Montant payé (€)</label>
            <input type="text" id="txtMontantHF" name="montant" size="10" maxlength="10" inputmode="decimal" required value="" />
          </p>
          <p>
            <label for="txtLibelleHF" id="libelleHFlabel">Détail <span class="facultatif">facultatif</span></label>
            <input type="text" id="txtLibelleHF" class="champ-large" name="libelle" maxlength="100" value=""
                   placeholder="Choisissez d'abord une catégorie" autocomplete="off" />
          </p>
          <p>
            <label for="pjHF">Facture</label>
            <span class="champ-fichier">
              <input type="file" id="pjHF" name="justificatifs[]" multiple
                     accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="pjHFaide" />
              <small id="pjHFaide">PDF, JPEG ou PNG, 5 Mo au plus par fichier. Ajoutable plus tard si besoin.</small>
            </span>
          </p>
        </div>
      </fieldset>
    </div>
    <div class="piedForm">
      <p>
        <input id="ajouter" type="submit" value="Ajouter la dépense" />
        <input id="effacer" type="reset" value="Effacer" />
      </p>
    </div>
  </form>
</div>
