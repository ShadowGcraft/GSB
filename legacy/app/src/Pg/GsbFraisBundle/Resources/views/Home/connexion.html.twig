{% extends "PgGsbFraisBundle::layout.html.twig" %}
{% block body %}
{% block bloc1 %}
<div id="contenu" class="contenu--connexion">
  <h2>Identification utilisateur</h2>
  {% if message is defined %}
    <div class="erreur" role="alert"><ul><li>{{ message }}</li></ul></div>
  {% endif %}
  <form method="POST" action="{{ path('pg_gsb_frais_validerconnexion') }}">
    <p>
      <label for="login">Login</label>
      <input id="login" type="text" name="login" size="30" maxlength="45" autocomplete="username" required />
    </p>
    <p>
      <label for="mdp">Mot de passe</label>
      <input id="mdp" type="password" name="mdp" size="30" maxlength="45" autocomplete="current-password" required />
    </p>
    <p class="piedForm">
      <input type="submit" value="Valider" name="valider" />
      <input type="reset" value="Annuler" name="annuler" />
    </p>
  </form>
</div>
{% endblock %}
{% endblock %}
