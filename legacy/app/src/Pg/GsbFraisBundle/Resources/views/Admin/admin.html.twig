{% extends "PgGsbFraisBundle::layout.html.twig" %}
{% block menu %}
{% set route = app.request.attributes.get('_route') %}
{% set estAdmin = app.session.get('role') == 'admin' %}
<nav id="menuGauche" aria-label="Navigation {{ estAdmin ? 'administrateur' : 'comptable' }}">
  <div id="infosUtil">
    <span class="infosUtil__role">{{ estAdmin ? 'Administrateur' : 'Comptable' }}</span>
    <span class="infosUtil__nom">Bonjour {{ app.session.get('prenom') }} {{ app.session.get('nom') }}</span>
  </div>
  <ul id="menuList">
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_admin_fiches') }}"{% if route starts with 'pg_gsb_frais_admin_fiche' %} aria-current="page"{% endif %}>Fiches de frais</a>
    </li>
    {% if estAdmin %}
    <li class="smenu">
      <a href="{{ path('pg_gsb_frais_admin_comptes') }}"{% if route starts with 'pg_gsb_frais_admin_compte' %} aria-current="page"{% endif %}>Comptes</a>
    </li>
    {% endif %}
  </ul>
  <a id="deconnexion" href="{{ path('pg_gsb_frais_deconnexion') }}">Déconnexion</a>
</nav>
{% endblock %}
