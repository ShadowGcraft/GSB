{% extends "PgGsbFraisBundle:Admin:admin.html.twig" %}
{% block body %}
{% set jeton = csrf_token('gsb_admin') %}
{% set modifiable = infos.idEtat == 'CL' %}
<div id="contenu" class="contenu--admin">
  <p class="fil"><a href="{{ path('pg_gsb_frais_admin_fiches') }}">← Fiches à valider</a></p>
  <div class="entete-page">
    <h2>{{ visiteur.prenom }} {{ visiteur.nom }} · fiche {{ nummois }}/{{ numannee }}</h2>
    {% if infos.idEtat != 'CR' %}
      <a class="bouton-petit" href="{{ path('pg_gsb_frais_admin_pdf', {'idVisiteur': visiteur.id, 'mois': mois}) }}" target="_blank" rel="noopener">Imprimer (PDF)</a>
    {% endif %}
  </div>
  {% include 'PgGsbFraisBundle:SaisirFrais:_messages.html.twig' %}

  <div class="encadre">
    <p class="encadre__etat">
      <span>État : <strong>{{ infos.libEtat }}</strong> depuis le {{ datemodif }}</span>
      <span>Justificatifs : <strong>{{ infos.nbJustificatifs }}</strong></span>
      <span>Montant dû : <strong>{{ montantcalcule }} €</strong></span>
      {% if infos.idEtat in ['VA', 'MP', 'RB'] %}<span>Montant validé : <strong>{{ infos.montantValide }} €</strong></span>{% endif %}
    </p>
    <p class="aide-texte">
      {% if vehicule %}
        Véhicule du mois : {{ vehicule.puissance }} {{ vehicule.carburant|lower }}, remboursé {{ vehicule.tarif|number_format(2, ',', ' ') }} € par km.
      {% else %}
        Aucun véhicule déclaré pour ce mois : les km gardent l'ancien taux unique.
      {% endif %}
    </p>
  </div>

  {# Étapes 5 et 6 : sur une fiche clôturée, les quantités se corrigent sur place (RG36, RG37). #}
  {% if modifiable %}<form method="post" action="{{ path('pg_gsb_frais_admin_corriger', {'idVisiteur': visiteur.id, 'mois': mois}) }}" class="form-corrections">
    <input type="hidden" name="_jeton" value="{{ jeton }}" />{% endif %}
  <div class="tableau-defilant">
    <table class="listeLegere">
      <caption>Éléments forfaitisés</caption>
      <tr>
        <th>Type de frais</th>
        <th class="montant">Quantité</th>
        <th class="montant">Tarif</th>
        <th class="montant">Total</th>
      </tr>
      {% for unfrais in lesfraisforfait %}
        <tr>
          <td>{% if modifiable %}<label for="frais-{{ unfrais.idfrais }}">{{ unfrais.libelle }}</label>{% else %}{{ unfrais.libelle }}{% endif %}</td>
          <td class="montant">
            {% if modifiable %}
              <span class="qte-saisie">
                <input type="text" id="frais-{{ unfrais.idfrais }}" name="lesFrais[{{ unfrais.idfrais }}]" class="champ-quantite"
                       size="6" maxlength="5" inputmode="numeric" pattern="[0-9]*" required value="{{ unfrais.quantite }}" />
                <span class="qte-saisie__unite">{{ unfrais.unite }}</span>
              </span>
            {% else %}
              {{ unfrais.quantite }} {{ unfrais.unite }}
            {% endif %}
          </td>
          <td class="montant">{{ unfrais.montant|number_format(2, '.', ' ') }} €</td>
          <td class="montant">{{ unfrais.total|number_format(2, '.', ' ') }} €</td>
        </tr>
      {% endfor %}
    </table>
  </div>
  {% if modifiable %}
    <p class="piedForm"><input type="submit" value="Enregistrer les quantités" /></p>
  </form>
  {% endif %}

  <div class="tableau-defilant">
    <table class="listeLegere">
      <caption>Éléments hors forfait</caption>
      <tr>
        <th class="date">Date</th>
        <th class="libelle">Libellé</th>
        <th class="montant">Montant</th>
        <th class="pj">Pièces jointes</th>
        <th class="action"><span class="visuellement-cache">Actions</span></th>
      </tr>
      {% for unfrais in lesfraishorsforfait %}
        <tr{% if unfrais.refuse %} class="ligne-refusee"{% endif %}>
          <td class="date">{{ unfrais.date }}</td>
          <td>{{ unfrais.libelle }}{% include 'PgGsbFraisBundle:ListeFrais:_report.html.twig' with {'origine': unfrais.moisOrigine} only %}{% if unfrais.refuse %} <span class="etiquette-refus">Refusé</span>{% endif %}</td>
          <td class="montant">{{ unfrais.montant }} €</td>
          <td class="pj">
            {% for pj in unfrais.justificatifs %}
              <a href="{{ path('pg_gsb_frais_justificatif_voir', {'id': pj.id}) }}" target="_blank" rel="noopener">{{ pj.nomOriginal }}</a>{% if not loop.last %}<br />{% endif %}
            {% else %}
              <span class="vide">Aucune</span>
            {% endfor %}
          </td>
          <td class="action">
            {% if modifiable %}
              <form method="post" action="{{ path('pg_gsb_frais_admin_refuserfrais', {'id': unfrais.id}) }}" class="form-inline">
                <input type="hidden" name="_jeton" value="{{ jeton }}" />
                <button type="submit" class="bouton-petit{{ unfrais.refuse ? '' : ' bouton-petit--danger' }}">{{ unfrais.refuse ? 'Réintégrer' : 'Refuser' }}</button>
              </form>
              {% if not unfrais.refuse %}
                {# Facture reçue après le 10 : le frais passe sur la fiche suivante (RG28). #}
                <form method="post" action="{{ path('pg_gsb_frais_admin_reporterfrais', {'id': unfrais.id}) }}" class="form-inline"
                      onsubmit="return confirm('Reporter ce frais sur la fiche {{ moissuivant }} ?');">
                  <input type="hidden" name="_jeton" value="{{ jeton }}" />
                  <button type="submit" class="bouton-petit" title="Reporter sur la fiche {{ moissuivant }}">Reporter</button>
                </form>
              {% endif %}
            {% endif %}
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="vide">Aucun frais hors forfait.</td></tr>
      {% endfor %}
    </table>
  </div>

  {% if infos.idEtat == 'CL' %}
    <form method="post" action="{{ path('pg_gsb_frais_admin_valider', {'idVisiteur': visiteur.id, 'mois': mois}) }}">
      <input type="hidden" name="_jeton" value="{{ jeton }}" />
      <div class="corpsForm">
        <fieldset>
          <legend>Validation</legend>
          <p>
            <label for="montantValide">Montant validé (€)</label>
            <input type="text" id="montantValide" name="montantValide" size="12" inputmode="decimal" value="{{ montantcalcule }}" required />
          </p>
          <p class="aide-texte">Proposé : forfaits au tarif en vigueur, km au tarif du véhicule, plus les frais hors forfait non refusés.</p>
        </fieldset>
      </div>
      <div class="piedForm"><p><input type="submit" value="Valider la fiche" /></p></div>
    </form>
  {% elseif infos.idEtat == 'VA' %}
    <form method="post" action="{{ path('pg_gsb_frais_admin_mettreenpaiement', {'idVisiteur': visiteur.id, 'mois': mois}) }}"
          onsubmit="return confirm('Mettre cette fiche en paiement ?');">
      <input type="hidden" name="_jeton" value="{{ jeton }}" />
      <div class="piedForm"><p><input type="submit" value="Mettre en paiement" /></p></div>
    </form>
  {% elseif infos.idEtat == 'MP' %}
    <form method="post" action="{{ path('pg_gsb_frais_admin_rembourser', {'idVisiteur': visiteur.id, 'mois': mois}) }}"
          onsubmit="return confirm('Confirmer le remboursement de cette fiche ?');">
      <input type="hidden" name="_jeton" value="{{ jeton }}" />
      <div class="piedForm"><p><input type="submit" value="Marquer comme remboursée" /></p></div>
    </form>
  {% elseif infos.idEtat == 'CR' %}
    <p class="aide-texte">Le visiteur saisit encore cette fiche : elle pourra être validée une fois clôturée.</p>
  {% endif %}
</div>
{% endblock %}
